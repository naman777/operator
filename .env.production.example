# Immutable image tags produced by CI or your container registry.
OPERATOR_API_IMAGE=registry.example.com/operator-api:git-sha
OPERATOR_WEB_IMAGE=registry.example.com/operator-web:git-sha

# Managed services. Store the real values in the platform secret manager.
DATABASE_URL=postgresql+psycopg://operator:replace-me@postgres.example.com:5432/operator?sslmode=require
TEMPORAL_ADDRESS=temporal.example.com:7233

# Only trust the private address/range of the TLS reverse proxy.
TRUSTED_PROXY_IPS=10.0.0.10
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000

# API admission controls and durable dispatch exhaustion policy.
OPERATOR_API_REQUESTS_PER_MINUTE=240
OPERATOR_GUEST_SESSIONS_PER_HOUR=20
OPERATOR_MISSION_MUTATIONS_PER_MINUTE=20
OPERATOR_DISPATCH_MAX_ATTEMPTS=8

# Optional model enrichment remains disabled until all values and prices are set.
OPERATOR_MODEL_ENABLED=0
OPERATOR_MODEL=
OPENAI_API_KEY=
OPERATOR_MODEL_BUDGET_RESERVE_USD=0.10
OPERATOR_MODEL_INPUT_USD_PER_MILLION=0
OPERATOR_MODEL_OUTPUT_USD_PER_MILLION=0
