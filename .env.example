# Optional: defaults to a local SQLite database for first-sprint development.
# DATABASE_URL=postgresql+psycopg://operator:operator_local@localhost:5432/operator
# Set API_URL in apps/web/.env.local if the API runs on another port.
# API_URL=http://127.0.0.1:8000

# Workflow worker defaults to the official local dev server.
# TEMPORAL_ADDRESS=127.0.0.1:7233

# Local MCP server. Use a guest token issued by POST /v1/guest-sessions.
# OPERATOR_API_URL=http://127.0.0.1:8000
# OPERATOR_TOKEN=replace-with-workspace-token
