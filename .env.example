# Optional: defaults to a local SQLite database for first-sprint development.
# DATABASE_URL=postgresql+psycopg://operator:operator_local@localhost:5432/operator
# Set API_URL in apps/web/.env.local if the API runs on another port.
# API_URL=http://127.0.0.1:8000

# Workflow worker defaults to the official local dev server.
# TEMPORAL_ADDRESS=127.0.0.1:7233

# Local MCP server. Use a guest token issued by POST /v1/guest-sessions.
# OPERATOR_API_URL=http://127.0.0.1:8000
# OPERATOR_TOKEN=replace-with-workspace-token

# Optional guarded model enrichment. All three values are required; otherwise
# matching and drafting use the deterministic local fallback without API calls.
# OPENAI_API_KEY=replace-with-project-key
# OPERATOR_MODEL_ENABLED=1
# OPERATOR_MODEL=gpt-5-mini
# OPERATOR_MODEL_BUDGET_RESERVE_USD=0.10
# Configure these rates for the selected model to record and enforce actual cost.
# OPERATOR_MODEL_INPUT_USD_PER_MILLION=0
# OPERATOR_MODEL_OUTPUT_USD_PER_MILLION=0
# OPERATOR_MODEL_MAX_OUTPUT_TOKENS=1200
# OPERATOR_MODEL_TIMEOUT_SECONDS=30
