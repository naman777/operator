# Copy to /opt/operator/.env.production on the server. Never commit real values.
OPERATOR_DOMAIN=operator.example.com
POSTGRES_USER=operator
POSTGRES_DB=operator
POSTGRES_PASSWORD=replace-with-a-long-random-password
# URL-encode special characters in the password used below.
DATABASE_URL=postgresql+psycopg://operator:replace-with-url-encoded-password@postgres:5432/operator

# CI overrides these with immutable commit tags during deployment.
OPERATOR_API_IMAGE=ghcr.io/owner/operator/api:commit-sha
OPERATOR_WEB_IMAGE=ghcr.io/owner/operator/web:commit-sha

OPERATOR_API_REQUESTS_PER_MINUTE=120
OPERATOR_GUEST_SESSIONS_PER_HOUR=10
OPERATOR_MISSION_MUTATIONS_PER_MINUTE=10
OPERATOR_DISPATCH_MAX_ATTEMPTS=8

# Keep model calls off for the first deployment. Add a key through the server's
# secret-delivery mechanism before enabling them.
OPERATOR_MODEL_ENABLED=0
OPERATOR_MODEL=
OPENAI_API_KEY=
OPERATOR_MODEL_BUDGET_RESERVE_USD=0.10
OPERATOR_MODEL_INPUT_USD_PER_MILLION=0
OPERATOR_MODEL_OUTPUT_USD_PER_MILLION=0
