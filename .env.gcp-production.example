# Copy required values into /opt/operator/.env.production without replacing that file.
OPERATOR_DOMAIN=operator.example.com

# Aiven application database. Keep sslmode=require.
DATABASE_URL=postgresql+psycopg://operator:replace-me@aiven-host:port/operator?sslmode=require

# Local PostgreSQL is exclusively for Temporal persistence.
TEMPORAL_POSTGRES_USER=temporal
TEMPORAL_POSTGRES_PASSWORD=replace-with-a-long-random-password
TEMPORAL_NAMESPACE=default
TEMPORAL_NAMESPACE_RETENTION=7d
TEMPORAL_NUM_HISTORY_SHARDS=128
TEMPORAL_LOG_LEVEL=info

# CI overrides these with immutable commit tags.
OPERATOR_API_IMAGE=ghcr.io/naman777/operator/api:commit-sha
OPERATOR_WEB_IMAGE=ghcr.io/naman777/operator/web:commit-sha

OPERATOR_API_REQUESTS_PER_MINUTE=120
OPERATOR_GUEST_SESSIONS_PER_HOUR=10
OPERATOR_MISSION_MUTATIONS_PER_MINUTE=10
OPERATOR_DISPATCH_MAX_ATTEMPTS=8

OPERATOR_MODEL_ENABLED=0
OPERATOR_MODEL=
OPENAI_API_KEY=
OPERATOR_MODEL_BUDGET_RESERVE_USD=0.10
OPERATOR_MODEL_INPUT_USD_PER_MILLION=0
OPERATOR_MODEL_OUTPUT_USD_PER_MILLION=0
