{
  "$defs": {
    "CompanyResearch": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "company": {
          "title": "Company",
          "type": "string"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/ResearchClaim"
          },
          "title": "Claims",
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "company"
      ],
      "title": "CompanyResearch",
      "type": "object"
    },
    "EligibilityCheck": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "check": {
          "title": "Check",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "candidate_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Value"
        },
        "required_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Value"
        }
      },
      "required": [
        "check",
        "status",
        "detail"
      ],
      "title": "EligibilityCheck",
      "type": "object"
    },
    "RequirementMatch": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "requirement_id": {
          "title": "Requirement Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "supported",
            "partial",
            "missing"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "status",
        "evidence_ids",
        "explanation"
      ],
      "title": "RequirementMatch",
      "type": "object"
    },
    "ResearchClaim": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "text",
        "source_id"
      ],
      "title": "ResearchClaim",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "excerpt": {
          "title": "Excerpt",
          "type": "string"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        },
        "synthetic": {
          "default": false,
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "url",
        "title",
        "excerpt"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "mission_id": {
      "title": "Mission Id",
      "type": "string"
    },
    "eligibility": {
      "enum": [
        "eligible",
        "ineligible",
        "unknown"
      ],
      "title": "Eligibility",
      "type": "string"
    },
    "eligibility_checks": {
      "items": {
        "$ref": "#/$defs/EligibilityCheck"
      },
      "title": "Eligibility Checks",
      "type": "array"
    },
    "score": {
      "maximum": 100,
      "minimum": 0,
      "title": "Score",
      "type": "number"
    },
    "rubric_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Rubric Version",
      "type": "string"
    },
    "matches": {
      "items": {
        "$ref": "#/$defs/RequirementMatch"
      },
      "title": "Matches",
      "type": "array"
    },
    "source_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Ids",
      "type": "array"
    },
    "company_research": {
      "anyOf": [
        {
          "$ref": "#/$defs/CompanyResearch"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "artifact_ids": {
      "items": {
        "type": "string"
      },
      "title": "Artifact Ids",
      "type": "array"
    }
  },
  "required": [
    "mission_id",
    "eligibility",
    "score",
    "matches",
    "source_ids",
    "artifact_ids"
  ],
  "title": "MissionResult",
  "type": "object"
}
