            "title": "Eligibility"
          },
          "score": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Score"
          },
          "rubric_version": {
            "type": "string",
            "const": "1.0",
            "title": "Rubric Version",
            "default": "1.0"
