  "components": {
    "schemas": {
      "CandidateProfile": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "graduation_year": {
            "type": "integer",
            "maximum": 2200.0,
            "minimum": 1900.0,
            "title": "Graduation Year"
          },
          "locations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Locations"
          },
          "skills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Skills"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "title": "Evidence"
          },
          "synthetic": {
            "type": "boolean",
            "title": "Synthetic",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "graduation_year",
          "locations",
          "skills",
          "evidence"
        ],
        "title": "CandidateProfile"
      },
      "EventView": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "mission_id": {
            "type": "string",
            "title": "Mission Id"
          },
          "sequence": {
            "type": "integer",
            "title": "Sequence"
          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "mission_id",
          "sequence",
          "type",
          "payload",
          "created_at"
        ],
        "title": "EventView"
      },
      "Evidence": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "document_id": {
            "type": "string",
            "title": "Document Id"
          },
          "source_location": {
            "type": "string",
            "title": "Source Location"
          },
          "skills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Skills"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "text",
          "document_id",
          "source_location",
          "skills"
        ],
        "title": "Evidence"
      },
      "FailureSimulation": {
        "properties": {
          "schema_version": {
            "type": "string",
